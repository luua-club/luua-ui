# Google OAuth client ID
# Get this from Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API backend URL
# Use your backend API URL (e.g., http://localhost:3000/api/v1 for local dev)
VITE_LUUA_BACKEND_URL=https://api.luua.club/api/v1

# LocalStorage key for user data
# Optional: defaults to 'luua-user' if not set
VITE_LUUA_LS_USER=luua-user

# PostHog Analytics Configuration
# Get your PostHog key from: https://posthog.com/
# Leave empty to disable analytics
VITE_PUBLIC_POSTHOG_KEY=your-posthog-key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_PUBLIC_REVERSE_PROXY_URL=your-reverse-proxy-url
